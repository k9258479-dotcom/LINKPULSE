{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/link1",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets|.*\\..*).*)",
      "destination": "/api/index"
    }
  ]
}
